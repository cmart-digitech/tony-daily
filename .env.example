# ── AI ────────────────────────────────────────────────────────────────
# Powers article summaries, the Daily Brief overview and Ask Tony Daily.
# Without any key the app still works; AI features show an honest
# "not configured" state rather than inventing content.
#
# Set ONE provider key to start. The provider is auto-detected from whichever
# key is present, or force it with AI_PROVIDER
# (anthropic | gemini | groq | xai | openrouter | mistral | custom).
#
# Setting a SECOND key is worthwhile: when one free tier hits its daily
# quota the next configured provider serves the request automatically
# (src/lib/ai/providers.ts). Setting AI_PROVIDER disables that failover.
#
#   Google Gemini   free tier, no card    https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Groq            free tier, no card    https://console.groq.com/keys
#   The recommended second provider: 14,400 requests/day, far larger than
#   Gemini's. Access can be intermittent — on 9 Sept 2026 both the API and
#   the signup console returned HTTP 403 "Access denied" from this network,
#   and by 10 Sept they were reachable again. If the console will not load,
#   retry later or use OpenRouter or Mistral instead.
GROQ_API_KEY=
#   OpenRouter      free models, no card  https://openrouter.ai/keys
#   ~50 requests/day free — small, but enough to cover a Gemini outage.
OPENROUTER_API_KEY=
#   Mistral         free experiment tier  https://console.mistral.ai
MISTRAL_API_KEY=
#   xAI Grok        credit-based, paid    https://console.x.ai
#   Not a free tier — use only as a last resort in the chain.
XAI_API_KEY=
#   Anthropic Claude  ~$5 starter credit  https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional overrides
AI_PROVIDER=
AI_MODEL=
# Only for AI_PROVIDER=custom (any OpenAI-compatible /chat/completions API)
AI_BASE_URL=
AI_API_KEY=

# ── Market data ───────────────────────────────────────────────────────
# Provider id. Supported: twelvedata
MARKET_DATA_PROVIDER=twelvedata
# Get a free key at https://twelvedata.com — required for quotes/watchlist prices.
# Without it the watchlist shows an honest "market data not configured" state.
TWELVE_DATA_API_KEY=

# ── Access control ────────────────────────────────────────────────────
# Either (or both) methods enable the login gate. Without any, the
# dashboard is OPEN to anyone with the URL (health reports authEnabled:false).
#
# Method 1 — password:
DASHBOARD_PASSWORD=
# Method 2 — Google Sign-In (create an OAuth client at
# https://console.cloud.google.com/apis/credentials, authorised redirect URI:
#   https://<your-app>/api/auth/google/callback
# Identity only — Drive access is a separate later consent):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed to sign in:
AUTHORIZED_EMAILS=
# Optional explicit session-signing secret (otherwise derived from the above):
AUTH_SECRET=

# ── Morning delivery (optional, free) ─────────────────────────────────
# Create a bot with @BotFather on Telegram, then message it once and read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# When both are set, the daily cron sends the brief to that chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── App ───────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Hong_Kong

# Shared secret protecting /api/ingest and /api/brief/generate when called
# by a scheduler (cron). Any random string.
CRON_SECRET=

# SQLite file path (defaults to ./data/tonydaily.db) — local dev only
DATABASE_URL=./data/tonydaily.db

# ── Hosted database (cloud deployments) ───────────────────────────────
# Free-tier hosts (Vercel etc.) have no persistent disk. Create a free
# Turso database (https://turso.tech) and set these; when present they
# take precedence over the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
