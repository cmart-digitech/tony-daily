# ── AI ────────────────────────────────────────────────────────────────
# Powers article summaries, the Daily Brief overview and Ask Tony Daily.
# Without any key the app still works; AI features show an honest
# "not configured" state rather than inventing content.
#
# Set ONE provider key. The provider is auto-detected from whichever key is
# present, or force it with AI_PROVIDER
# (anthropic | gemini | groq | xai | openrouter | mistral | custom).
#
#   Google Gemini   free tier, no card    https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   Groq            free tier, no card    https://console.groq.com/keys
GROQ_API_KEY=
#   xAI Grok                              https://console.x.ai
XAI_API_KEY=
#   OpenRouter      free models           https://openrouter.ai/keys
OPENROUTER_API_KEY=
#   Mistral         free experiment tier  https://console.mistral.ai
MISTRAL_API_KEY=
#   Anthropic Claude  ~$5 starter credit  https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional overrides
AI_PROVIDER=
AI_MODEL=
# Only for AI_PROVIDER=custom (any OpenAI-compatible /chat/completions API)
AI_BASE_URL=
AI_API_KEY=

# ── Market data ───────────────────────────────────────────────────────
# Provider id. Supported: twelvedata
MARKET_DATA_PROVIDER=twelvedata
# Get a free key at https://twelvedata.com — required for quotes/watchlist prices.
# Without it the watchlist shows an honest "market data not configured" state.
TWELVE_DATA_API_KEY=

# ── App ───────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Hong_Kong

# Shared secret protecting /api/ingest and /api/brief/generate when called
# by a scheduler (cron). Any random string.
CRON_SECRET=

# SQLite file path (defaults to ./data/tonydaily.db) — local dev only
DATABASE_URL=./data/tonydaily.db

# ── Hosted database (cloud deployments) ───────────────────────────────
# Free-tier hosts (Vercel etc.) have no persistent disk. Create a free
# Turso database (https://turso.tech) and set these; when present they
# take precedence over the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
