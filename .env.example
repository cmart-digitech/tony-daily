# ── AI ────────────────────────────────────────────────────────────────
# Required for: article summaries, Daily Brief generation, Ask Tony Daily.
# Without it the app still works; AI features show an honest "not configured" state.
ANTHROPIC_API_KEY=

# ── Market data ───────────────────────────────────────────────────────
# Provider id. Supported: twelvedata
MARKET_DATA_PROVIDER=twelvedata
# Get a free key at https://twelvedata.com — required for quotes/watchlist prices.
# Without it the watchlist shows an honest "market data not configured" state.
TWELVE_DATA_API_KEY=

# ── App ───────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Hong_Kong

# Shared secret protecting /api/ingest and /api/brief/generate when called
# by a scheduler (cron). Any random string.
CRON_SECRET=

# SQLite file path (defaults to ./data/tonydaily.db) — local dev only
DATABASE_URL=./data/tonydaily.db

# ── Hosted database (cloud deployments) ───────────────────────────────
# Free-tier hosts (Vercel etc.) have no persistent disk. Create a free
# Turso database (https://turso.tech) and set these; when present they
# take precedence over the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
